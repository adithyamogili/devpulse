# Local-only credentials. Never commit .env.
POSTGRES_DB=devpulse
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=devpulse
DATABASE_URL=postgresql://devpulse:devpulse@postgres:5432/devpulse
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=30
GITHUB_MAX_RETRIES=3
GITHUB_REPOSITORIES=adithyamogili/mailmon-backend,adithyamogili/mailmon-frontend,adithyamogili/Metatconvo,adithyamogili/olist-data-engineering,fastapi/fastapi,django/django,apache/airflow
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=github-raw
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=github.raw.records
